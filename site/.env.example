# Plantilla de variables de entorno — SIN VALORES REALES.
#
# ⚠️ NUNCA pongas claves aquí ni en ningún archivo del repo.
#    Los valores reales se configuran SOLO en Vercel:
#    Vercel → Project → Settings → Environment Variables.
#    `.env*` está gitignorado; este `.env.example` es solo documentación.

# --- Formulario de contacto (OPCIONAL) -------------------------------------
# Solo hacen falta si el cliente usa <ContactForm/>.
# Si usas <ContactoDirecto/> (WhatsApp + tel:, el caso normal), NO necesitas nada.
RESEND_API_KEY=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=

# --- Rating de Google auto-sync (OPCIONAL) ---------------------------------
# Sin estas, `lib/google-rating.ts` usa el valor de respaldo (FALLBACK).
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACE_ID=

# --- SEO: sitemap + robots -------------------------------------------------
# URL pública del sitio, sin barra final. La resuelve src/lib/site-url.ts y la usan el
# sitemap, el robots.txt y los canonical/Open Graph del layout.
#
# NO hace falta rellenarla para desplegar en Vercel: si está vacía se usa
# VERCEL_PROJECT_PRODUCTION_URL, que Vercel inyecta sola y es estable entre despliegues.
# Rellénala SOLO cuando el cliente tenga dominio propio (p. ej. https://ejemplo.org).
SITE_URL=

# Indexación en Google. Por defecto (vacío) = NOINDEX -> protege las demos.
# Ponlo a "true" SOLO cuando sea un cliente real en su dominio de producción
# (si no, su web no aparecerá en Google). Ver la checklist de A6.
SITE_INDEXABLE=
